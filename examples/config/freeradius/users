# BEGIN pi-set-go MAB examples
# Disabled templates: remove ONE leading "# " from each line of a chosen entry.
# The Session-Timeout line remains commented; enable it separately if needed.
# Match the MAC username/password case and separators sent by your NAS.
# Assumes the NAS sends the MAC as both username and password (PAP/CHAP).
# MAB uses the outer/default server, not the PEAP inner tunnel.
# MAB + RPPSK below uses Cisco iPSK Cisco-AVPair attributes.
# The PSK is the device Wi-Fi key; the RADIUS password is its MAC.
# Enable MAC authentication and, for RPPSK, RADIUS PSK support on the WLAN.

# MAB only — Airespace interface 1
# 020000000001 Cleartext-Password := "020000000001"
#     # Session-Timeout := 3600,
#     Airespace-Interface-Name := "1"

# MAB only — tunnel VLAN 1
# 020000000002 Cleartext-Password := "020000000002"
#     # Session-Timeout := 3600,
#     Tunnel-Type := VLAN,
#     Tunnel-Medium-Type := IEEE-802,
#     Tunnel-Private-Group-Id := "1"

# MAB + RPPSK (Cisco iPSK) — Airespace interface 1
# 020000000003 Cleartext-Password := "020000000003"
#     # Session-Timeout := 3600,
#     Cisco-AVPair += "psk-mode=ascii",
#     Cisco-AVPair += "psk=REPLACE-WITH-8-TO-63-CHAR-PSK",
#     Airespace-Interface-Name := "1"

# MAB + RPPSK (Cisco iPSK) — tunnel VLAN 1
# 020000000004 Cleartext-Password := "020000000004"
#     # Session-Timeout := 3600,
#     Cisco-AVPair += "psk-mode=ascii",
#     Cisco-AVPair += "psk=REPLACE-WITH-8-TO-63-CHAR-PSK",
#     Tunnel-Type := VLAN,
#     Tunnel-Medium-Type := IEEE-802,
#     Tunnel-Private-Group-Id := "1"

# END pi-set-go MAB examples
